{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "xenoglyphiq-kit/fixture.schema.json",
  "title": "Conformance fixture manifest (conformance/manifest.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability", "spec_version", "oracle", "generated_at", "cases"],
  "properties": {
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "spec_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "package", "version"],
      "properties": { "language": { "type": "string" }, "package": { "type": "string" }, "version": { "type": "string" }, "script": { "type": "string" } }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "op", "level", "input", "expect", "compare"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$", "description": "Unique, stable id; never reuse a retired id" },
          "op": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Operation name from capability.yaml" },
          "level": { "enum": ["core", "io", "full"] },
          "group": { "type": "string" },
          "description": { "type": "string" },
          "input": { "$ref": "#/$defs/payload" },
          "options": { "type": "object", "description": "Option overrides, canonical snake_case keys" },
          "expect": {
            "oneOf": [
              { "$ref": "#/$defs/payload" },
              {
                "type": "object", "additionalProperties": false, "required": ["error"],
                "properties": {
                  "error": {
                    "type": "object", "additionalProperties": false, "required": ["kind", "code"],
                    "properties": {
                      "kind": { "enum": ["invalid_input", "unsupported", "limit_exceeded", "not_found", "io", "internal"] },
                      "code": { "type": "string" },
                      "offset": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            ]
          },
          "compare": { "enum": ["exact", "float_tol", "bytes", "set_equal", "json_equal"] },
          "tolerance": { "type": "number", "exclusiveMinimum": 0 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "source": { "enum": ["oracle", "spec", "fuzz", "bug"], "default": "oracle", "description": "Where the case came from" }
        },
        "if": { "properties": { "compare": { "const": "float_tol" } } },
        "then": { "required": ["tolerance"] }
      }
    }
  },
  "$defs": {
    "payload": {
      "type": "object", "additionalProperties": false,
      "description": "Exactly one of: inline canonical-JSON value, file path, or base64 bytes",
      "oneOf": [
        { "required": ["value"] },
        { "required": ["file"] },
        { "required": ["base64"] }
      ],
      "properties": {
        "value": { "description": "Canonical JSON (.kit/CONVENTIONS.md §5)" },
        "file": { "type": "string", "description": "Path relative to conformance/cases/" },
        "base64": { "type": "string" },
        "args": { "type": "object", "description": "Named extra arguments, canonical snake_case" }
      }
    }
  }
}
